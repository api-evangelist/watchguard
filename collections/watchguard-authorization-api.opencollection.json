{
  "opencollection": "1.0.0",
  "info": {
    "name": "WatchGuard Cloud Platform Accounts Authorization API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Audience Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.usa.cloud.watchguard.com/rest/platform/authorization/v1/audiences",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the audience parameter value for a managed account. Required by service providers when submitting API requests on behalf of a managed account."
        }
      ]
    }
  ],
  "bundled": true
}
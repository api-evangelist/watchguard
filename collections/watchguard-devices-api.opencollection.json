        {
          "info": {
            "name": "List Unmanaged Devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usa.cloud.watchguard.com/rest/accounts/:accountId/unmanageddevices",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "WatchGuard Cloud account ID."
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Number of records to return (max 3000)."
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination."
              },
              {
                "name": "$search",
                "value": "",
                "type": "query",
                "description": "Text search across supported fields."
              },
              {
                "name": "$count",
                "value": "",
                "type": "query",
                "description": "Include total count in response."
              },
              {
                "name": "$orderby",
                "value": "",
                "type": "query",
                "description": "Sort results (e.g., hostname+asc)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve devices discovered on the network that are not yet managed."
        }
